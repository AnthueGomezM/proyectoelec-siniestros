# =============================================================================
# Plantilla de variables de entorno. Copia este archivo a .env y completa la clave.
#   cp .env.example .env
# NUNCA se versiona un .env con claves reales (.gitignore lo excluye).
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Dentro de docker compose el host es "db" (nombre del servicio).
DATABASE_URL=postgresql://claims:claims_local_pwd@db:5432/claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims_local_pwd
POSTGRES_DB=claims

# --- Proveedor de IA ---------------------------------------------------------
# gemini  = Google Gemini (requiere GEMINI_API_KEY)
# offline = sin modelo externo; el agente corre con reglas deterministas
LLM_PROVIDER=gemini

# Obtén una clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# --- Límites del agente (los cuatro, activos) --------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOKENS=8000
AGENT_REQUIRE_CONFIRMATION=true

# Si el proveedor falla (429, caída, timeout), continuar en modo determinista
# en vez de dejar el siniestro sin clasificar.
ALLOW_OFFLINE_FALLBACK=true

# Timeout de cada llamada al modelo (segundos)
LLM_TIMEOUT_SECONDS=10
LLM_TEMPERATURE=0.0

# --- Servidor ----------------------------------------------------------------
APP_PORT=8000
LOG_LEVEL=INFO
