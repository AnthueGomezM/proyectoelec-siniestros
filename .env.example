# =============================================================================
# Plantilla de variables de entorno. Copia este archivo a .env y completa la clave.
#   cp .env.example .env
# NUNCA se versiona un .env con claves reales (.gitignore lo excluye).
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Dentro de docker compose el host es "db" (nombre del servicio).
DATABASE_URL=postgresql://claims:claims_local_pwd@db:5432/claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims_local_pwd
POSTGRES_DB=claims

# --- Proveedor de IA ---------------------------------------------------------
# gemini  = Google Gemini (requiere GEMINI_API_KEY)
# offline = sin modelo externo; el agente corre con reglas deterministas
LLM_PROVIDER=gemini

# Obtén una clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# --- Acceso del personal -------------------------------------------------------
# Cuentas del personal: usuario:rol:clave separadas por ";". Roles: trabajador | ti.
# La clave debe tener 8 caracteres o más y no puede llevar ";", comillas ni "$".
# Las comillas de la línea son necesarias: run.sh lee este archivo con bash.
# CAMBIA ESTAS CLAVES. El cliente que reporta un siniestro no necesita cuenta.
AUTH_USERS="ana:trabajador:ana123;luis:trabajador:luis123;soporte:ti:soporte123"
# Firma de las sesiones. Vacío = se genera al arrancar (las sesiones se cierran al reiniciar).
# Para que sobrevivan reinicios:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Ponlo en true cuando se sirva por HTTPS (la cookie de sesión solo viajará cifrada).
AUTH_COOKIE_SECURE=false
# SOLO desarrollo local: true desactiva el inicio de sesión de /trabajador y /ti.
AUTH_DISABLED=false

# --- Base de datos: rol de solo lectura del agente ---------------------------
# Lo crea db/03-roles.sh. docker-compose arma AGENT_DATABASE_URL con esta clave.
AGENT_DB_PASSWORD=agent_ro_local_pwd

# --- Frecuencia y gasto --------------------------------------------------------
# Reportes por IP (POST /api/claims es público y cada uno gasta tokens del modelo).
RATE_CLAIMS_PER_MINUTE=10
RATE_CLAIMS_PER_HOUR=60
# Intentos de inicio de sesión fallidos por IP antes de bloquear 5 minutos.
RATE_LOGIN_FAILURES=5
# Techo de tokens en 24 h. Superado, los triajes siguen en modo determinista (0 tokens).
# 0 = sin techo.
LLM_DAILY_TOKEN_BUDGET=200000

# --- Límites del agente (los cuatro, activos) --------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOKENS=8000
AGENT_REQUIRE_CONFIRMATION=true

# Si el proveedor falla (429, caída, timeout), continuar en modo determinista
# en vez de dejar el siniestro sin clasificar.
ALLOW_OFFLINE_FALLBACK=true

# Timeout de cada llamada al modelo (segundos)
LLM_TIMEOUT_SECONDS=10
LLM_TEMPERATURE=0.0
# Esfuerzo de razonamiento de Gemini 3: minimal | low | medium | high (vacio = el del modelo).
# Los tokens de razonamiento gastan cuota aunque no se vean; "low" basta para este triaje.
GEMINI_THINKING_LEVEL=low

# --- Imágenes adjuntas --------------------------------------------------------
# Carpeta dentro del contenedor donde se guardan las fotos de los siniestros
# (persiste gracias al volumen "uploads" de docker-compose).
UPLOADS_DIR=/data/uploads
# Tamaño máximo de imagen aceptado, en MB
MAX_IMAGE_MB=8
# Lado mayor (px) al que se reduce la foto antes de enviarla al modelo de vision (menos tokens).
# El original no se modifica: el ajustador lo ve completo.
IMAGE_MAX_SIDE=1024

# --- Servidor ----------------------------------------------------------------
APP_PORT=8000
LOG_LEVEL=INFO
